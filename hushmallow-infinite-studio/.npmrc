# npm writes a debug log for every `npm run`, and rotates old ones, in its logs-dir.
# Keep both inside WORK so npm never writes (or deletes) its logs outside the studio
# root. logs-max=0 is NOT used: npm then deletes existing logs elsewhere.
# One npm write cannot be moved from here: npm >= 10.9 enables Node's compile cache
# for its OWN modules (lib/cli.js) before it reads any config, in $TMPDIR/node-compile-cache.
# The write audit verifies every such entry (render/lib/write-audit.mjs); `node cli/hm.mjs …`
# is the npm-free way to run every studio command.
logs-dir=/home/user/hm-work/npm-logs
update-notifier=false
