{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thinkstill-ritual-v58.20.7-no-tips.schema.json",
  "title": "ThinkStill Ritual v58.20.7 NO-TIPS",
  "type": "object",
  "required": [
    "id",
    "b",
    "name",
    "goal",
    "steps",
    "win",
    "mindBend",
    "formulaFlow",
    "safety",
    "thinking_error",
    "precise_subpattern"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TS-[0-9]{3}$"
    },
    "b": {
      "type": "string",
      "enum": [
        "GLITCH",
        "DROP",
        "STILL",
        "PATCH",
        "LOOPIE",
        "RUSH",
        "SYNC"
      ]
    },
    "name": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "steps": {
      "type": "string"
    },
    "win": {
      "type": "string"
    },
    "mindBend": {
      "type": "string"
    },
    "formulaFlow": {
      "type": "string"
    },
    "safety": {
      "type": "string"
    },
    "thinking_error": {
      "type": "string"
    },
    "precise_subpattern": {
      "type": "string"
    },
    "routing_weight": {
      "type": "number",
      "minimum": 0
    },
    "safety_tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
