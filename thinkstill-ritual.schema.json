{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thinkstill-ritual.schema.json",
  "title": "ThinkStill Ritual v20.3",
  "type": "object",
  "required": [
    "id",
    "bubble",
    "displayName",
    "safetyClass",
    "resetDNA",
    "fingerprint",
    "defaultMode",
    "modes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TS-[0-9]{3}$"
    },
    "bubble": {
      "type": "string",
      "enum": [
        "GLITCH",
        "DROP",
        "STILL",
        "PATCH",
        "LOOPIE",
        "RUSH",
        "SYNC"
      ]
    },
    "displayName": {
      "type": "string"
    },
    "canonicalTechnique": {
      "type": "string"
    },
    "bestFor": {
      "type": "string"
    },
    "playTime": {
      "type": "string"
    },
    "safetyClass": {
      "type": "string"
    },
    "resetDNA": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string"
    },
    "supportFirst": {
      "type": "boolean"
    },
    "supportFirstBypass": {
      "type": "boolean"
    },
    "defaultMode": {
      "const": "Cheeky"
    },
    "modes": {
      "type": "object",
      "required": [
        "jolly",
        "cheeky",
        "unfiltered"
      ],
      "properties": {
        "jolly": {
          "$ref": "#/$defs/modeCopy"
        },
        "cheeky": {
          "$ref": "#/$defs/modeCopy"
        },
        "unfiltered": {
          "$ref": "#/$defs/modeCopy"
        }
      }
    }
  },
  "$defs": {
    "modeCopy": {
      "type": "object",
      "required": [
        "mode",
        "openingLine",
        "ritualCard",
        "mindBend",
        "safety",
        "supportFirst",
        "modePolicy",
        "contentFingerprint"
      ],
      "properties": {
        "mode": {
          "enum": [
            "Jolly",
            "Cheeky",
            "Unfiltered"
          ]
        },
        "openingLine": {
          "type": "string"
        },
        "ritualCard": {
          "type": "string"
        },
        "mindBend": {
          "type": "string"
        },
        "safety": {
          "type": "string"
        },
        "supportFirst": {
          "type": "boolean"
        },
        "modePolicy": {
          "type": "string"
        },
        "gentleCard": {
          "type": "string"
        },
        "optionalCheckIn": {
          "type": "string"
        },
        "returnPrompt": {
          "type": "string"
        },
        "contentFingerprint": {
          "type": "string"
        }
      }
    }
  }
}
