{
  "name": "hushmallow-another-angle",
  "private": true,
  "version": "1.0.0",
  "description": "Server for Another Angle in hushmallow Beyond (Cloudflare Worker). Never shipped to GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261012.1",
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  },
  "scripts": {
    "test": "node --import ./test/register.mjs --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "build:check": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev --env dev",
    "harness": "node --import ./test/register.mjs tools/local-harness.mjs",
    "e2e:billing": "node scripts/billing-e2e.mjs",
    "sync:lexicon": "node scripts/sync-lexicon.mjs",
    "sync:screen": "node scripts/sync-screen.mjs",
    "eval": "node ../../tools/angle-eval.mjs",
    "replay:gate": "node eval/replay-gate.mjs",
    "extract:log": "node eval/extract-log.mjs",
    "deploy": "wrangler deploy"
  }
}
