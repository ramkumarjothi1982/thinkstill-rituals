  "properties": {
    "schema": {
      "const": "thinkstill-manifest-v20.3"
    },
    "version": {
      "const": "20.3.0"
    },
    "rowCount": {
      "const": 750
    },
    "modeRowCount": {
      "const": 2250
    },
    "supportFirstCount": {
      "const": 25
    },
    "firstSessionCount": {
      "const": 50
    },
    "defaultMode": {
      "const": "Cheeky"
    },
    "availableModes": {
      "type": "array",
      "const": [
        "Jolly",
        "Cheeky",
        "Unfiltered"
      ]
    },
    "data": {
      "type": "object"
    }
  }
}
