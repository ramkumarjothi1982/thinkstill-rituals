{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThinkStill Ritual Record",
  "type": "object",
  "required": [
    "ritual_number",
    "id",
    "bubble",
    "title",
    "trigger",
    "pattern",
    "play_time",
    "hook_internal",
    "goal_internal",
    "game_move_internal",
    "ritual",
    "win",
    "formula_flow",
    "safety",
    "emotional_distress_support",
    "if_this_doesnt_help",
    "breath_support",
    "mindfulness_support",
    "positive_psychology_support",
    "contemplative_support",
    "friend_echo",
    "optional_support_stack",
    "release_routing_trigger",
    "secondary_routing_trigger",
    "release_routing_pattern"
  ],
  "properties": {
    "ritual_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 400
    },
    "id": {
      "type": "string",
      "pattern": "^T-[0-9]{3}$"
    },
    "bubble": {
      "type": "string",
      "enum": [
        "GLITCH",
        "DROP",
        "STILL",
        "PATCH",
        "LOOPIE",
        "RUSH",
        "SYNC"
      ]
    },
    "title": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "trigger": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "pattern": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "play_time": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "hook_internal": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "goal_internal": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "game_move_internal": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "ritual": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "win": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "formula_flow": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "safety": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "emotional_distress_support": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "if_this_doesnt_help": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "breath_support": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "mindfulness_support": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "positive_psychology_support": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "contemplative_support": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "friend_echo": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "optional_support_stack": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "release_routing_trigger": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "secondary_routing_trigger": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "release_routing_pattern": {
      "type": [
        "string",
        "number",
        "null"
      ]
    }
  }
}