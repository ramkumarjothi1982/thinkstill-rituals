{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thinkstill.app/schemas/ritual-v13.json",
  "title": "ThinkStill Ritual v13",
  "type": "object",
  "required": [
    "id",
    "ritual_number",
    "bubble",
    "name",
    "play_time",
    "domain",
    "best_for",
    "thinking_error",
    "precise_subpattern",
    "unique_game_move",
    "goal",
    "rule",
    "play",
    "twist",
    "win",
    "mind_bend",
    "safety",
    "engine_fingerprint",
    "fullRitual"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TS-[0-9]{3}$"
    },
    "ritual_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 750
    },
    "bubble": {
      "enum": [
        "GLITCH",
        "DROP",
        "LOOPIE",
        "PATCH",
        "RUSH",
        "STILL",
        "SYNC"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "play_time": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "best_for": {
      "type": "string",
      "minLength": 1
    },
    "thinking_error": {
      "type": "string",
      "minLength": 1
    },
    "precise_subpattern": {
      "type": "string",
      "minLength": 1
    },
    "unique_game_move": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "play": {
      "type": "string",
      "minLength": 1
    },
    "twist": {
      "type": "string",
      "minLength": 1
    },
    "win": {
      "type": "string",
      "minLength": 1
    },
    "mind_bend": {
      "type": "string",
      "minLength": 1
    },
    "safety": {
      "type": "string",
      "minLength": 1
    },
    "engine_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "fullRitual": {
      "type": "string",
      "minLength": 1
    },
    "first_session_pick": {
      "type": "boolean",
      "description": "Growth-layer flag; does not alter locked ritual content."
    },
    "first_session_rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "description": "Optional rank among the curated first-session set."
    },
    "reset_dna_family": {
      "type": "string",
      "minLength": 1,
      "description": "Product mechanism family used only for user-rated adaptive routing and Reset DNA."
    }
  }
}
