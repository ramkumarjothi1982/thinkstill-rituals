{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThinkStill Ritual v37.9",
  "type": "object",
  "required": [
    "ritual_number",
    "id",
    "bubble",
    "title",
    "play_time",
    "goal",
    "steps",
    "win",
    "supports",
    "formula_flow",
    "safety"
  ],
  "properties": {
    "ritual_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 400
    },
    "id": {
      "type": "string",
      "pattern": "^T-[0-9]{3}$"
    },
    "bubble": {
      "enum": [
        "GLITCH",
        "DROP",
        "STILL",
        "PATCH",
        "LOOPIE",
        "RUSH",
        "SYNC"
      ]
    },
    "title": {
      "type": "string"
    },
    "play_time": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "n",
          "move",
          "action"
        ],
        "properties": {
          "n": {
            "type": "integer"
          },
          "move": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "win": {
      "type": "string"
    },
    "supports": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "formula_flow": {
      "type": "string"
    },
    "safety": {
      "type": "string"
    }
  }
}