{
  "name": "hushmallow-infinite-studio",
  "version": "0.2.0",
  "private": true,
  "description": "Hushmallow Infinite Studio \u2014 premium vertical short videos starring the approved Mallows. Phase 1 (v2) is frozen; Phase 2 builds the generator.",
  "type": "module",
  "engines": {
    "node": ">=22.2"
  },
  "scripts": {
    "test": "node cli/hm.mjs test guard unit parity property",
    "test:guard": "node cli/hm.mjs test guard",
    "test:unit": "node cli/hm.mjs test unit",
    "test:parity": "node cli/hm.mjs test parity",
    "test:property": "node cli/hm.mjs test property",
    "test:golden": "node cli/hm.mjs test golden",
    "test:derive": "node cli/hm.mjs test derive",
    "lib:validate": "node cli/hm.mjs lib validate",
    "hm": "node cli/hm.mjs",
    "guard": "node cli/hm.mjs guard",
    "heavy": "node render/lib/heavy-lock.mjs",
    "jail": "node render/lib/write-jail.mjs",
    "render": "node render/lib/heavy-lock.mjs --shared --label legacy-render -- node render/render.mjs",
    "bench:probe": "node render/lib/heavy-lock.mjs --exclusive --label bench-probe -- node tools/timing.mjs",
    "derive": "node render/lib/heavy-lock.mjs --exclusive --label derive -- python3 -I",
    "preview": "node render/lib/write-jail.mjs -- node render/serve.mjs"
  },
  "dependencies": {
    "playwright": "1.56.1"
  }
}
