{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thinkstill-modes.schema.json",
  "title": "ThinkStill Modes v20.3",
  "type": "object",
  "required": [
    "schema",
    "version",
    "rowCount",
    "ritualCount",
    "defaultMode",
    "availableModes",
    "modes"
  ],
  "properties": {
    "schema": {
      "const": "thinkstill-modes-v20.3"
    },
    "version": {
      "const": "20.3.0"
    },
    "rowCount": {
      "const": 2250
    },
    "ritualCount": {
      "const": 750
    },
    "defaultMode": {
      "const": "Cheeky"
    },
    "availableModes": {
      "type": "array",
      "const": [
        "Jolly",
        "Cheeky",
        "Unfiltered"
      ]
    },
    "modes": {
      "type": "array",
      "minItems": 2250,
      "maxItems": 2250,
      "items": {
        "type": "object",
        "required": [
          "id",
          "mode",
          "ritualCard",
          "contentFingerprint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TS-[0-9]{3}$"
          },
          "mode": {
            "enum": [
              "Jolly",
              "Cheeky",
              "Unfiltered"
            ]
          },
          "ritualCard": {
            "type": "string"
          },
          "contentFingerprint": {
            "type": "string"
          }
        }
      }
    }
  }
}
