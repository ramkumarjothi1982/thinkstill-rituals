{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*.js",
    "types/**/*.d.ts",
    "tools/**/*.mjs",
    "scripts/**/*.mjs",
    "eval/**/*.js",
    "eval/**/*.mjs"
  ],
  "exclude": [
    "src/safety/shared-lexicon.js",
    "src/safety/risk-screen.js"
  ]
}
