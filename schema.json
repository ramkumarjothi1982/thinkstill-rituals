{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThinkStill Ritual v40",
  "type": "object",
  "required": [
    "id",
    "world",
    "specialist",
    "title",
    "goal",
    "steps",
    "win",
    "tips",
    "mindBend",
    "formulaFlow",
    "safety",
    "feedbackOptions"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "world": {
      "enum": [
        "CALM",
        "CLEAR",
        "FOCUS",
        "CONNECT",
        "WORK",
        "PERFORM",
        "MEANING"
      ]
    },
    "specialist": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 2
    },
    "win": {
      "type": "string"
    },
    "tips": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "mindBend": {
      "type": "string"
    },
    "formulaFlow": {
      "type": "string"
    },
    "safety": {
      "type": "string"
    },
    "safetyTier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "feedbackOptions": {
      "type": "array",
      "minItems": 3
    }
  }
}