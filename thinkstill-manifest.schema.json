{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thinkstill-manifest.schema.json",
  "title": "ThinkStill Manifest v20.3",
  "type": "object",
  "required": [
    "schema",
    "version",
    "rowCount",
    "modeRowCount",
    "supportFirstCount",
    "firstSessionCount",
    "defaultMode",
    "availableModes",
    "data"
